# Copy to `.env` (which is gitignored) and fill in real values. See DEPLOY.md.
# Generate a secret with: mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-output-of-mix-phx.gen.secret
# The public domain the app is served from, e.g. attendance.example.com
PHX_HOST=attendance.example.com
# Optional. Store the SQLite database on the host instead of in a Docker
# volume: point this at a host directory (it must be writable by UID 65534,
# the container's `nobody` user). Leave it unset to use the `db-data` volume.
# DATABASE_DIR=/srv/attendancetracker/db
